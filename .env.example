# Значения читаются из окружения процесса; .env автоматически не загружается.
LOGOS_DATABASE_PATH=data/logos.sqlite3
# Разрешённые Origin для CSRF-проверки изменяющих запросов (не CORS).
# Атрибут Secure cookie от этой переменной не зависит: он берётся из схемы запроса.
LOGOS_ALLOWED_ORIGINS=http://localhost:5173
LOGOS_PUBLIC_BASE_URL=http://localhost:5173
LOGOS_SMTP_HOST=127.0.0.1
LOGOS_SMTP_PORT=1026
LOGOS_SMTP_FROM=no-reply@logos.local
LOGOS_SMTP_TIMEOUT=10
# Для реального SMTP-провайдера раскомментируйте и задайте значения.
# Пароль SMTP не помещать в VITE_*, CLI-аргументы или логи.
# LOGOS_SMTP_USERNAME=
# LOGOS_SMTP_PASSWORD=
# LOGOS_SMTP_TLS=starttls
# Токен демо-бота для миграции 0009 (LOGOS_DEMO_SEED=1); без него демо-канал не подключается.
# LOGOS_DEMO_BOT_TOKEN=
